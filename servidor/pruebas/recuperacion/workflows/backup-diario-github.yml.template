name: Respaldo Diario de Base de Datos (Repositorio Privado)

on:
  schedule:
    - cron: '0 2 * * *'
  workflow_dispatch:

jobs:
  backup-diario:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Obtener fecha actual para identificacion del artefacto
        id: metadatos
        run: |
          echo "fecha=$(date -u +'%Y-%m-%d')" >> $GITHUB_OUTPUT

      - name: Clonar codigo de la plataforma (repositorio publico)
        uses: actions/checkout@v7
        with:
          repository: 'leonar1lol/sistema-sostenibilidad-retail'
          ref: 'main'

      - name: Configurar Node.js 20 LTS
        uses: actions/setup-node@v7
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: servidor/package-lock.json

      - name: Instalar dependencias del servidor
        run: npm ci --omit=dev
        working-directory: servidor

      - name: Instalar cliente oficial PostgreSQL 18 (apt.postgresql.org)
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq lsb-release curl ca-certificates gnupg
          sudo install -d /etc/apt/keyrings
          curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | sudo gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg
          echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list
          sudo apt-get update -qq
          sudo apt-get install -y -qq postgresql-client-18
          /usr/lib/postgresql/18/bin/pg_dump --version

      - name: Preparar directorio seguro para artefacto de salida
        run: |
          mkdir -p "${{ runner.temp }}/backup-output"

      - name: Generar respaldo diario cifrado y manifest SHA-256
        run: node scripts/respaldo/entradaBackupDiario.js
        working-directory: servidor
        env:
          DATABASE_URL: ${{ secrets.NEON_BACKUP_DATABASE_URL }}
          BACKUP_ENCRYPTION_KEY: ${{ secrets.BACKUP_ENCRYPTION_KEY }}
          BACKUP_OUTPUT_DIR: ${{ runner.temp }}/backup-output
          PG_DUMP_BIN: /usr/lib/postgresql/18/bin/pg_dump

      - name: Subir artefacto privado a GitHub Actions con retencion de 9 dias
        uses: actions/upload-artifact@v4
        with:
          name: backup-full-${{ steps.metadatos.outputs.fecha }}
          path: |
            ${{ runner.temp }}/backup-output/backup.enc
            ${{ runner.temp }}/backup-output/manifest.json
          retention-days: 9
          if-no-files-found: error
