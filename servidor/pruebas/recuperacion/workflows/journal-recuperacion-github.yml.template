name: Exportacion de Journal de Recuperacion (Repositorio Privado)

on:
  schedule:
    - cron: '0 */2 * * *'
  workflow_dispatch:

jobs:
  exportar-journal:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Obtener marca temporal para identificacion del artefacto
        id: metadatos
        run: |
          echo "fecha=$(date -u +'%Y-%m-%d')" >> $GITHUB_OUTPUT
          echo "hora=$(date -u +'%H')" >> $GITHUB_OUTPUT

      - name: Clonar codigo de la plataforma (repositorio publico)
        uses: actions/checkout@v7
        with:
          repository: 'leonar1lol/sistema-sostenibilidad-retail'
          ref: 'main'

      - name: Configurar Node.js 20 LTS
        uses: actions/setup-node@v7
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: servidor/package-lock.json

      - name: Instalar dependencias del servidor
        run: npm ci --omit=dev
        working-directory: servidor

      - name: Preparar directorio seguro para artefacto de salida
        run: |
          mkdir -p "${{ runner.temp }}/journal-output"

      - name: Exportar journal incremental cifrado de las ultimas 2 horas
        run: node scripts/respaldo/entradaExportarJournal.js
        working-directory: servidor
        env:
          DATABASE_URL: ${{ secrets.NEON_BACKUP_DATABASE_URL }}
          BACKUP_ENCRYPTION_KEY: ${{ secrets.BACKUP_ENCRYPTION_KEY }}
          BACKUP_OUTPUT_DIR: ${{ runner.temp }}/journal-output

      - name: Subir artefacto privado a GitHub Actions con retencion de 9 dias
        uses: actions/upload-artifact@v4
        with:
          name: journal-${{ steps.metadatos.outputs.fecha }}-${{ steps.metadatos.outputs.hora }}
          path: |
            ${{ runner.temp }}/journal-output/journal.enc
            ${{ runner.temp }}/journal-output/manifest.json
          retention-days: 9
          if-no-files-found: error
